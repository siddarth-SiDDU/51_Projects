line level    source

   1          #include <reg51.h>
   2          
   3          // Pin definitions for LCD Control Pins
   4          sbit RS = P3^5;
   5          sbit EN = P3^6;
   6          
   7          // Keypad Port Definition
   8          #define KEYPAD_PORT P1
   9          
  10          // Function Declarations
  11          void delay_ms(unsigned int ms);
  12          void lcd_cmd(unsigned char cmd);
  13          void lcd_data(unsigned char data_out);
  14          void lcd_init(void);
  15          char keypad_scan(void);
  16          
  17          // 4x4 Keypad Map Matrix
  18          char code keymap[4][4] = {
  19              {'1', '2', '3', 'A'},
  20              {'4', '5', '6', 'B'},
  21              {'7', '8', '9', 'C'},
  22              {'*', '0', '#', 'D'}
  23          };
  24          
  25          void main(void) {
  26   1          char key;
  27   1          lcd_init();               // Initialize 16x2 LCD
  28   1          
  29   1          // Display Initial Message
  30   1          lcd_cmd(0x80);            // Force cursor to 1st line, 1st position
  31   1          lcd_data('P'); lcd_data('r'); lcd_data('e'); lcd_data('s'); 
  32   1          lcd_data('s'); lcd_data(' '); lcd_data('K'); lcd_data('e'); lcd_data('y'); lcd_data(':');
  33   1          
  34   1          lcd_cmd(0xC0);            // Move cursor to 2nd line
  35   1          
  36   1          while(1) {
  37   2              key = keypad_scan();  // Scan keypad for keypress
  38   2              if(key != 0) {
  39   3                  lcd_data(key);    // Display pressed key character on LCD
  40   3              }
  41   2          }
  42   1      }
  43          
  44          // Millisecond Delay Routine
  45          void delay_ms(unsigned int ms) {
  46   1          unsigned int i, j;
  47   1          for(i = 0; i < ms; i++)
  48   1              for(j = 0; j < 120; j++);
  49   1      }
  50          
  51          // Send Command to LCD
  52          void lcd_cmd(unsigned char cmd) {
  53   1          P2 = cmd;                 // Load command to Data Port (P2)
  54   1          RS = 0;                   // RS = 0 for Command
C51 COMPILER V9.60.7.0   KEYPAD_INTERFACE                                                  10/09/2026 15:22:21 PAGE 2   

  55   1          EN = 1;                   // Pulse Enable high-to-low
  56   1          delay_ms(2);
  57   1          EN = 0;
  58   1      }
  59          
  60          // Send Data (Character) to LCD
  61          void lcd_data(unsigned char data_out) {
  62   1          P2 = data_out;            // Load ASCII data to Data Port (P2)
  63   1          RS = 1;                   // RS = 1 for Data
  64   1          EN = 1;                   // Pulse Enable high-to-low
  65   1          delay_ms(2);
  66   1          EN = 0;
  67   1      }
  68          
  69          // Initialize LCD in 8-bit Mode
  70          void lcd_init(void) {
  71   1          delay_ms(20);
  72   1          lcd_cmd(0x38);            // 8-bit mode, 2 lines, 5x7 matrix
  73   1          lcd_cmd(0x0C);            // Display ON, Cursor OFF
  74   1          lcd_cmd(0x06);            // Entry mode: Auto-increment cursor
  75   1          lcd_cmd(0x01);            // Clear display
  76   1          delay_ms(2);
  77   1      }
  78          
  79          // Scan Keypad for Pressed Keys
  80          char keypad_scan(void) {
  81   1          unsigned char row, col;
  82   1          
  83   1          for(row = 0; row < 4; row++) {
  84   2              // Set all rows HIGH, then pull current scanning row LOW
  85   2              KEYPAD_PORT = 0xFF;
  86   2              KEYPAD_PORT &= ~(1 << row);
  87   2              
  88   2              // Read columns (P1.4 to P1.7)
  89   2              if((KEYPAD_PORT & 0xF0) != 0xF0) {
  90   3                  delay_ms(20);     // Software debounce delay
  91   3                  if((KEYPAD_PORT & 0xF0) != 0xF0) {
  92   4                      // Determine column index
  93   4                      if((KEYPAD_PORT & 0x10) == 0) col = 0;
  94   4                      else if((KEYPAD_PORT & 0x20) == 0) col = 1;
  95   4                      else if((KEYPAD_PORT & 0x40) == 0) col = 2;
  96   4                      else if((KEYPAD_PORT & 0x80) == 0) col = 3;
  97   4                      
  98   4                      // Wait until key is released (prevents multiple prints)
  99   4                      while((KEYPAD_PORT & 0xF0) != 0xF0);
 100   4                      
 101   4                      return keymap[row][col];
 102   4                  }
 103   3              }
 104   2          }
 105   1          return 0;                 // Return 0 if no key is pressed
 106   1      }


