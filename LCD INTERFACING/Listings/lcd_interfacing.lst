  15          void delay_ms(unsigned int itime)
  16          {
  17   1          unsigned int i, j;
  18   1          for(i = 0; i < itime; i++)
  19   1          for(j = 0; j < 200; j++);
  20   1      }
  21          
  22          /* Send command to LCD */
  23          void LCD_WriteCommand(unsigned char cmd)
  24          {
  25   1          DataBus = cmd;
  26   1          RS = 0;                 
  27   1          EN = 1;
  28   1          delay_ms(1);
  29   1          EN = 0;
  30   1          delay_ms(2);
  31   1      }
  32          
