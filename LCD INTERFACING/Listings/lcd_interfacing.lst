  50   1          LCD_WriteCommand(0x38); // 8-bit mode, 2 lines, 5x7
  51   1          LCD_WriteCommand(0x0C); // Display ON, cursor OFF
  52   1          LCD_WriteCommand(0x01); // Clear display
  53   1          LCD_WriteCommand(0x06); // Cursor moves right
  54   1          LCD_WriteCommand(0x80); // First line, first position
